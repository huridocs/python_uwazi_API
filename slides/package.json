{
  "name": "uwazi-admin-agent-deck",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "slidev slides.md",
    "export": "slidev export slides.md",
    "export:png": "slidev export slides.md --format png --per-slide --output dist/slides --wait 800 --timeout 60000",
    "video": "uv run scripts/narrate.py"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "slidev-theme-mokkapps": "^1.3.2"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.18",
    "@iconify-json/uim": "^1.2.3",
    "playwright-chromium": "1.62.1"
  }
}
